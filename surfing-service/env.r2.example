# Surfing → R2 / CDN (Phase 1) env
#
# PVC remains write-through + fallback. Set SURFING_OBJECT_STORE=r2 to publish
# new uploads to Cloudflare R2; manifest URLs become absolute CDN links and
# GET /serve redirects to them.
#
# Create a dedicated bucket (recommended: dasmlab-surfing) and a fresh R2 API
# token — sailgp-era keys in ~/r2_creds currently 403.

SURFING_OBJECT_STORE=r2
R2_ACCOUNT_ID=cf7984c0e7fb6252115f14daabbeea1e
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dasmlab-surfing
R2_PUBLIC_BASE_URL=https://pub-973dadf41dd44837be5bcdd8913067a7.r2.dev
R2_S3_URL=https://cf7984c0e7fb6252115f14daabbeea1e.r2.cloudflarestorage.com/dasmlab-surfing
# Optional overrides:
# R2_ENDPOINT=https://cf7984c0e7fb6252115f14daabbeea1e.r2.cloudflarestorage.com
# SURFING_CDN_BASE_URL=https://media.surfing.dasmlab.org
# Note: *.r2.dev is rate-limited — swap to custom domain on dasmlab.org when zone is on CF.

# Theme generator (MVP). Dev → OpenAI; later → cheapcloud AI farm (OpenAI-compatible).
SURFING_AI_PROVIDER=openai
SURFING_AI_BASE_URL=https://api.openai.com/v1
SURFING_AI_API_KEY=
SURFING_AI_CHAT_MODEL=gpt-4o-mini
SURFING_AI_IMAGE_MODEL=gpt-image-1
# Future:
# SURFING_AI_PROVIDER=cheapcloud
# SURFING_AI_BASE_URL=https://cheapcloud-ai.apps.../v1

# Share tollgate (public base for minted /s/:token links)
# SURFING_SHARE_PUBLIC_BASE=https://dev-lmcdasm-dasmlab-home.apps.2026-prod-1.ocp.dasmlab.org/api/surfing
# SURFING_SHARE_PATH_PREFIX=/api/surfing
# SURFING_CHEAPCLOUD_HIT_URL=https://cheapcloud-dasmlab.apps.2026-prod-1.ocp.dasmlab.org/api/v1/media/share-hits
